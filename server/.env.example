# 개발용: SDK 토큰 검증 없이 provider만으로 세션 생성 (테스트·에뮬레이터)
# 로컬 카카오 로그인 테스트 시 true 권장
AUTH_SKIP_VERIFY=true

# 운영·실 SDK 연동 시 false 로 두고 아래 값을 채우세요.
# AUTH_SKIP_VERIFY=false

# Google idToken aud 검증 (Web Client ID)
GOOGLE_CLIENT_ID=

# Apple identityToken aud (번들 ID)
APPLE_BUNDLE_ID=com.mechuri

# 네이버 로그인 (auth.local.ts consumerKey/Secret 과 동일)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 근처 먹기 — 카카오 로컬 API (developers.kakao.com REST API 키)
KAKAO_REST_API_KEY=
